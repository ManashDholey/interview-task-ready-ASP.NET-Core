int[] numbers = {1, 2, 3, 1, 3};

        // LINQ Query to find duplicate elements
        var duplicates = numbers.GroupBy(x => x)
                                .Where(g => g.Count() > 1)
                                .Select(g => g.Key);

        // Output the results
        Console.WriteLine("Duplicate elements: " + string.Join(", ", duplicates));
